{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibezoo.dev/schemas/config.schema.json",
  "title": "Zoo Configuration Schema",
  "description": "Validates .zoo/config.json files for VibeZoo projects",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URI"
    },
    "defaultMode": {
      "type": "string",
      "enum": ["code", "code-crow", "architect", "debug", "ask", "orchestrator", "orchestrator-crow"],
      "description": "Default AI mode slug applied when the project loads"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Crow Memory schema version (semver)"
    },
    "project": {
      "type": "string",
      "description": "Project identifier name"
    },
    "crow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoRecall": {
          "type": "boolean",
          "description": "Automatically call crow_recall on session start"
        },
        "autoIngest": {
          "type": "boolean",
          "description": "Automatically call crow_ingest on session end"
        }
      },
      "description": "Crow Memory auto-behavior flags"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of available custom mode slugs"
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of MCP server names registered for this project"
    }
  },
  "required": ["defaultMode"]
}
