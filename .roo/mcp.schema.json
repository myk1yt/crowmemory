{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibezoo.dev/schemas/mcp.schema.json",
  "title": "MCP Configuration Schema",
  "description": "Validates .roo/mcp.json files for VibeZoo projects",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URI"
    },
    "mcpServers": {
      "type": "object",
      "description": "Map of MCP server names to their configurations",
      "additionalProperties": {
        "$ref": "#/definitions/McpServer"
      }
    }
  },
  "required": ["mcpServers"],
  "definitions": {
    "McpServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sse", "stdio"],
          "description": "Transport protocol: SSE for HTTP streaming, stdio for local process"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Server URL (required when type is 'sse')"
        },
        "command": {
          "type": "string",
          "description": "Shell command to start the server (required when type is 'stdio')"
        },
        "alwaysAllow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of tool names that are always allowed without user confirmation"
        }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "sse" } }
          },
          "then": {
            "required": ["url"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "stdio" } }
          },
          "then": {
            "required": ["command"]
          }
        }
      ]
    }
  }
}
