{
  "mcpServers": {
    "crow_memory": {
      "command": "python",
      "args": [
        "crow_mcp_server.py",
        "--state",
        "./memory/crow.bin"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "disabled": false,
      "alwaysAllow": [
        "crow_recall",
        "crow_ingest",
        "crow_ingest_from_build",
        "crow_evolve_propose",
        "crow_diagnostics",
        "crow_check_drift",
        "crow_get_user_bias",
        "crow_manage_prompt",
        "crow_manage_backup",
        "crow_project_info"
      ]
    }
  }
}
